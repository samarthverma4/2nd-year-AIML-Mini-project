# Azure OpenAI — GPT-5.5 via the Responses API (story text generation, required)
# Endpoint must be the FULL Responses URL including api-version query string.
AZURE_OPENAI_TEXT_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_TEXT_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/openai/responses?api-version=2025-04-01-preview
AZURE_OPENAI_TEXT_MODEL=gpt-5.5

# Azure OpenAI GPT-4o — Moonface face scanning
GPT4O_VISION_API_KEY=your_azure_api_key_here
GPT4O_VISION_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/openai/deployments/gpt-4o/chat/completions?api-version=2025-01-01-preview

# Azure OpenAI gpt-4o-mini-tts — expressive TTS with `instructions` steering
# The endpoint must be the full deployment URL, including api-version.
AZURE_TTS_API_KEY=your_azure_openai_key_here
AZURE_TTS_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/openai/deployments/gpt-4o-mini-tts/audio/speech?api-version=2025-03-01-preview

# Azure OpenAI gpt-realtime-translate (multilingual story delivery)
# Endpoint is the full chat-completions URL for the translate deployment.
AZURE_OPENAI_TRANSLATE_API_KEY=your_azure_openai_key_here
AZURE_OPENAI_TRANSLATE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/openai/deployments/gpt-realtime-translate/chat/completions?api-version=2025-01-01-preview
AZURE_OPENAI_TRANSLATE_MODEL=gpt-realtime-translate

# Azure OpenAI gpt-image-2 (required for image generation)
# Get these from your Azure AI Foundry / Cognitive Services resource
AZURE_GPT_IMAGE_API_KEY=your_azure_gpt_image_api_key_here
AZURE_GPT_IMAGE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/openai/deployments/gpt-image-2/images/generations?api-version=2024-02-01

# Auth
JWT_SECRET_KEY=your_random_secret_key_here
TOKEN_EXPIRY_HOURS=72

# Google OAuth (optional — enables "Continue with Google" on the login page)
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorised JavaScript origins: http://localhost:5002
# Authorised redirect URIs: not required (token-based flow)
GOOGLE_CLIENT_ID=

# Database (leave empty for SQLite fallback)
DATABASE_URL=

# Cloud Storage (optional — leave empty for local storage)
# AWS_S3_BUCKET=your-bucket-name
# AWS_S3_REGION=us-east-1
# AZURE_STORAGE_CONNECTION_STRING=
# AZURE_STORAGE_CONTAINER=story-images
